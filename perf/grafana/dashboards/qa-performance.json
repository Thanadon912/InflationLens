        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "lens-perf-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (status) (rate(k6_http_reqs_total{testid=\"$testid\",name=~\"$endpoint\",status!~\"2..\"}[1m]))",
          "refId": "A",
          "range": true,
          "instant": false,
          "legendFormat": "HTTP {{status}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "lens-perf-prometheus"
          },
          "editorMode": "code",
          "expr": "(sum(rate(k6_http_reqs_total{testid=\"$testid\",name=~\"$endpoint\",expected_response=\"false\"}[1m])) or vector(0))",
          "refId": "B",
          "range": true,
          "instant": false,
          "legendFormat": "all failures"
        }
      ],
      "pluginVersion": "11.5.1"
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Load applied vs. throughput delivered",
      "description": "The saturation panel. While the API keeps up, both lines rise together. The moment virtual users keep climbing and requests/sec flattens, the API has stopped scaling \u2014 that crossover point is the answer the stress scenario exists to produce.",
